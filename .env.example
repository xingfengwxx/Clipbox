# Clipbox 服务端部署配置模板：复制为仓库根目录 .env 后填写。
#   cp .env.example .env
# .env 已被 .gitignore 忽略；真实令牌不得写入仓库、Dockerfile 或 docker-compose.yml。
# 占位值仅用于解析，部署前替换为 `openssl rand -base64 48` 的输出。
# ADMIN_TOKEN：管理令牌，至少 32 个字符。
ADMIN_TOKEN=<REPLACE_WITH_OPENSSL_RAND_BASE64_48_OUTPUT>
# PUBLIC_BASE_URL：分享链接基地址，学习版使用 HTTP，无尾斜杠、无路径与查询串。
PUBLIC_BASE_URL=http://<SERVER_IP>:8080

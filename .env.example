# Clipbox 服务端部署配置模板：复制为仓库根目录 .env 后填写。
#   cp .env.example .env
# .env 已被 .gitignore 忽略；真实配置不得写入仓库、Dockerfile 或 docker-compose.yml。
# PUBLIC_BASE_URL：分享链接基地址，学习版使用 HTTP，无尾斜杠、无路径与查询串。
PUBLIC_BASE_URL=http://<SERVER_IP>:8080
# DOWNLOAD_HOST_DIR：宿主机安装包目录，只读挂载到容器。本地开发保持 ./downloads；
# 服务器设为 /srv/clipbox/downloads（该目录由 release CI 自动写入）。
DOWNLOAD_HOST_DIR=./downloads
